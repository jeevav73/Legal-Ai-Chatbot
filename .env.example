# No paid API key is required for this project — Aalap-Mistral-7B and
# InLegalBERT are both open-source models downloaded from HuggingFace.

# Optional: only needed if a model repo you use later is "gated" on
# HuggingFace and requires login (Aalap and InLegalBERT are NOT gated).
# HUGGINGFACE_TOKEN=

# Set to true only after you've run train.py and produced a LoRA adapter
# in models/nyaya-aalap-lora/
USE_FINE_TUNED_ADAPTER=false
